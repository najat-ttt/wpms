rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access to ensure no unauthenticated or unintended access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper function to verify that the request is authenticated 
    // AND the authenticated user's ID matches the requested resource's user ID.
    // This strictly prevents users from accessing another user's data.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Protects the user profile document:
    // Only the authenticated owner can read or write their own user profile data.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Protects the wedding profile document:
    // Only the authenticated owner can access their own wedding profile details.
    match /users/{userId}/wedding/profile {
      allow read, write: if isOwner(userId);
    }
    
    // Protects the tasks subcollection:
    // Only the authenticated owner can read, create, update, or delete their own tasks.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if isOwner(userId);
    }
    
    // Protects the vendors subcollection:
    // Only the authenticated owner can read, create, update, or delete their own vendors.
    match /users/{userId}/vendors/{vendorId} {
      allow read, write: if isOwner(userId);
    }
  }
}
